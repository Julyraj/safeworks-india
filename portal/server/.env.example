# SafeWorks Portal server — every environment variable, one line each. Copy to .env and fill in; never commit the real .env.
DATABASE_URL=postgres://safeworks:safeworks@127.0.0.1:5432/safeworks   # PostgreSQL 16 connection string
PORT=8080                                   # listen port
HOST=0.0.0.0                                # listen address
APP_ENV=production                          # production refuses dev-only secrets
WEB_CONCURRENCY=2                           # uvicorn worker processes (1 on very small servers)
DB_POOL_MAX=20                              # asyncpg pool size per process
FILE_SIGNING_SECRET=change-me-to-64-hex-characters   # signs file links, upload tickets, status links (openssl rand -hex 32)
FIELD_ENCRYPTION_KEY=change-me-base64-32-bytes      # AES-GCM key for phones, reporter contacts, anonymous seals, TOTP secrets (openssl rand -base64 32)
FILE_LINK_TTL_SECONDS=3600                  # life of a signed photo link
STORAGE_DRIVER=disk                         # disk (STORAGE_DIR) or db (file_blobs table, for hosts without a persistent disk)
STORAGE_DIR=/data/storage                   # where photos, voice notes and reports are kept when STORAGE_DRIVER=disk
DATA_DIR=/app/data                          # the library data folder (industries.json is read from here by the seed)
WEB_DIST=/app/portal/web/dist               # built web front ends
PUBLIC_URL=https://safeworks.yourcompany.in # address in QR posters, status links and emails
CORS_ORIGINS=https://localhost,capacitor://localhost   # origins allowed to call the API (the Android app)
TRUST_PROXY=true                            # behind a reverse proxy / load balancer
RUN_JOBS=true                               # run the background jobs in this process
AUTO_MIGRATE=true                           # apply migrations/*.sql at start
LOG_LEVEL=info                              # uvicorn/app log level
APP_TIMEZONE=Asia/Kolkata                   # calendar for working days, quiet hours and job schedules
SESSION_HOURS_FIELD=720                     # field app session life (hours)
SESSION_HOURS_ADMIN=8                       # admin console session life (hours)
MAX_FAILED_LOGINS=10                        # lock the account after this many failures in LOCK_MINUTES
LOCK_MINUTES=15                             # lock duration
USER_RATE_LIMIT=600                         # API requests per minute per user (per process)
MAX_MEDIA_BYTES=10485760                    # PUT /media cap (10 MB)
QR_PER_TOKEN_HOUR=30                        # public QR submissions per token per hour
QR_PER_IP_HOUR=10                           # public QR submissions per IP per hour (salted hash, 24 h)
QR_MAX_PAYLOAD=15728640                     # public QR JSON payload cap (15 MB)
EXPORTS_PER_HOUR=10                         # CSV exports per user per hour
IP_HASH_SALT=                               # salt for the QR rate-limit IP hashes (defaults to FILE_SIGNING_SECRET)
HASH_THREADS=8                              # scrypt worker threads
SLOW_MS=1000                                # log API requests slower than this
SMTP_URL=                                   # smtps://user:password@smtp.example.in:465 (empty: emails stay queued)
MAIL_FROM=SafeWorks <no-reply@yourcompany.in>
VAPID_PUBLIC_KEY=                           # Web Push (python -m py_vapid or `vapid --gen`); empty: push rows are marked failed
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:safety@yourcompany.in
SEED_ORG_NAME=SafeWorks demo company        # organisation name on first seed (SEED_COMPANY also accepted)
SEED_ADMIN_ID=ADMIN01                       # first admin's employee code
SEED_ADMIN_PASSWORD=                        # first admin's password (generated and printed when empty)
DEMO_PASSWORD=                              # password of the --demo users (falls back to SEED_ADMIN_PASSWORD)
SEED_ON_START=false                         # start.sh: run the seed before the server
SEED_DEMO=false                             # start.sh: seed with --demo
