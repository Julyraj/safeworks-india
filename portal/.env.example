# Copy to .env and fill in. Never commit the real .env.

# Database password used by docker-compose (long and random)
DB_PASSWORD=change-me-to-a-long-random-password

# Signs short-lived photo links. At least 32 random characters, e.g. `openssl rand -hex 32`
FILE_SIGNING_SECRET=change-me-to-64-hex-characters

# The address people type in the browser and the Android app (HTTPS)
PUBLIC_URL=https://safeworks.yourcompany.in

# Origins allowed to call the API from the Android app (leave as is)
CORS_ORIGINS=https://localhost,capacitor://localhost

# Set to true when running behind a reverse proxy / load balancer
TRUST_PROXY=true

# Email for assignments, closures, reminders and escalations (optional). Without it, emails stay queued.
# Example: smtps://user:password@smtp.yourcompany.in:465
SMTP_URL=
MAIL_FROM=SafeWorks <no-reply@yourcompany.in>

# First-time seed
SEED_COMPANY=Your Company Name
SEED_ADMIN_ID=ADMIN01

# API worker processes (Python). 2 suits a 2-vCPU server; use 1 on very small servers.
WEB_CONCURRENCY=2
